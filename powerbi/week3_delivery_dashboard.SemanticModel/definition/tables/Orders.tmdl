	partition Orders = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\src\E-commerce-Delivery-Logistics-Performance-Analysis\data\interim\kpi_orders_all.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    BlankToNull = Table.ReplaceValue(PromotedHeaders, "", null, Replacer.ReplaceValue, Table.ColumnNames(PromotedHeaders)),
				    Typed = Table.TransformColumnTypes(BlankToNull, {{"order_id", type text}, {"order_status", type text}, {"customer_state", type text}, {"region", type text}, {"order_purchase_timestamp", type datetime}, {"weekday_num", Int64.Type}, {"weekday", type text}, {"category", type text}, {"n_items", type number}, {"order_value", type number}, {"freight_total", type number}, {"review_score", type number}, {"approval_days", type number}, {"handling_days", type number}, {"delivery_days", type number}, {"delay_days", type number}, {"is_on_time", type number}, {"is_canceled", type number}, {"is_low_rating", type number}}),
				    UnclassifiedCategory = Table.ReplaceValue(Typed, null, "Unclassified", Replacer.ReplaceValue, {"category"}),
				    PurchaseMonth = Table.AddColumn(UnclassifiedCategory, "purchase_month", each if [order_purchase_timestamp] = null then null else Date.ToText(Date.StartOfMonth(DateTime.Date([order_purchase_timestamp])), "yyyy-MM"), type text)
				in
				    PurchaseMonth

	annotation PBI_ResultType = Table
