table Orders
	lineageTag: 00000000-0000-0000-0000-000000000100

	measure 'Unique Orders' = DISTINCTCOUNT ( Orders[order_id] )
		formatString: #,0
		lineageTag: 00000000-0000-0000-0000-000000000121

	measure 'Average Elapsed Delivery Days' = CALCULATE ( AVERAGE ( Orders[delivery_days] ), Orders[order_status] = "delivered", NOT ISBLANK ( Orders[delivery_days] ), Orders[delivery_days] >= 0 )
